# ORB // 2088 — desenvolvimento local
# PostgreSQL 18 rodando localmente (servico: postgresql-x64-18)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orb2088?schema=public"

# Banco separado para os testes de integracao (tests/db.test.ts)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/orb2088_test?schema=public"

# Troque antes de qualquer deploy. Gere com: openssl rand -base64 48
AUTH_SECRET="orb2088-dev-secret-troque-em-producao-0000000000000000000"

# debug | info | warn | error  (producao defaulta: info)
LOG_LEVEL="debug"

NEXT_PUBLIC_APP_NAME="ORB // 2088"